################################################################################
### PMT channels with issues
###
#
# the following PMT were found to have issues during commissioning
# on January 2021 (or earlier).
# See e.g. SBN DocDB 20696 (see plots on slide 7).
#
icarus_trigger_channel_ignore_202101: [
   70, 106, 217,                     # PMT not working [SBN DocDB 20696]
   54,  58,  67,  98, 112, 153, 254  # hot channels [SBN DocDB 20696] 
]

# default selection of PMT channels to ignore
icarus_trigger_channel_ignore: @local::icarus_trigger_channel_ignore_202101


################################################################################
###
### icarus_dynamictriggergate: variable length gates
###
icarus_dynamictriggergate: {
  
  tool_type: DynamicTriggerGateBuilderTool
  
  ChannelThresholds: @local::icarus_triggergate_basic.ChannelThresholds
  
} # icarus_dynamictriggergate


################################################################################
###
### icarus_fixedtriggergate: fixed length gates
###

# The "legacy" configuration has been used until icaruscode v09_92_00;
# it is based on a misunderstanding (the way the discrimination happens)
# and a hardware misconfiguration (wrong waveform discrimination polarity).
# In Run4 the misconfiguration is fixed.
icarus_fixedtriggergate_legacy: {
  
  tool_type: FixedTriggerGateBuilderTool
  
  ChannelThresholds: @local::icarus_triggergate_basic.ChannelThresholds
  
  # minimum duration of a trigger gate
  GateDuration: @local::icarus_triggergate_basic.PMTdiscrGateWidth
  
} # icarus_fixedtriggergate_legacy

# These settings are historical of ICARUS Run3.
# The hardware until Run3 (included) was set to discriminate PMT waveforms on
# the trailing edge of a signal
# (or, equivalently, the leading edge of a signal with "positive" polarity).
# The discrimination mode based on 4 samples is also activated here
# (the hardware always used it, but we were not aware of that).
icarus_triggergate_run3: {
  
  tool_type: TrailingFixedTriggerGateBuilderTool
  
  ChannelThresholds: @local::icarus_triggergate_basic.ChannelThresholds
  
  # duration of a trigger gate
  GateDuration: "160 ns"

  # use for discrimination the "highest" of four samples;
  # time is referred to the first of the four samples.
  SamplingPattern: [ true, true, true, true ]
  
} # icarus_triggergate_run3


# Configuration to reproduce at the best of our understanding the hardware
# configuration in Run4. Compared to Run3, PMT signals are discriminated at the
# leading egde.
icarus_triggergate_run4: {
  
  @table::icarus_triggergate_run3
  
  # the configuration of TrailingFixedTriggerGateBuilderTool
  # and FixedTriggerGateBuilderTool are the same
  tool_type: FixedTriggerGateBuilderTool
  
} # icarus_triggergate_run4

# Configuration to reproduce at the best of our understanding the hardware
# configuration in Run5, that is the same as Run4.
icarus_triggergate_run5: @local::icarus_triggergate_run4

icarus_fixedtriggergate: @local::icarus_triggergate_run4



################################################################################
icarus_region_finder: {
  
  # waveform baseline [ADC counts]
  Baseline: @local::icarus_triggergate_basic.Baseline
  
  # minimum sampled value for a region to start
  EnablingThreshold: @local::icarus_triggergate_basic.ChannelThresholds[0]
  
  # sampled value below which a region ends (default: as `EnablingThreshold`)
  # DisablingThreshold: 5
  
  # how many samples above threshold for a region to start
  MinSamplesAboveThreshold: 3  # default
  
  # how many samples below threshold for a region to end
  # (default: as `MinSamplesAboveThreshold`)
  # MinSamplesBelowThreshold: 3
  
} # icarus_region_finder



################################################################################
###  Trigger evaluation gates
# 
# Preset configurations are available in `beamgates_icarus.fcl` to help the
# workflow include the starting beam gate data product (there, its standard tag
# is also defined, but we can't refer to it directly here because that
# configuration file includes this one).
#
# this configuration takes the configured beam gate duration
# and creates extended gates to be used for trigger evaluation;
# [20221104] the amount of extension needs to be verified with Run2 data
# [20260415] shifting for the cable delay, that is now simulated at waveform level:
#            -200 (margin) + 265 (average delay for Run2 data);
#            estimation from the reconstructed triggering flash times,
#            from simulation enabling trigger emulation (with no trigger delay)
#            and standard hit reconstruction (which includes time correction).
#            Simulation adds the delay, then the shifting to trigger time eats it,
#            and the hit correction effectively moves the hits away from the trigger.
#            There are other ways to estimate it (e.g. average on DB coefficients!)
# [20260507] tuning Run2 gates: spills 128 ns (BNB) and 200 ns (NuMI) after gate
#            opening; expecting neutrinos to appear at +30 ns (simulation time)
#            because of simulated propagation time from the flux window (-20 m)
#            to the face of the detector (~-10 m); values hard-coded because
#            they're observed in Run2 data
# [20260616] detaching the "trigger input" delay of 224 ns from the gate start
#
# Data summary:    |       Run2        |       Run3        |  Run4   |  Run5   |
#                  |   BNB   |  NuMI   |   BNB   |  NuMI   |   BNB   |   BNB   |
# ---------------- | ------- | ------- | ------- | ------- | ------- | ------- |
# Trigger delay    |  225 ns |  225 ns |  225 ns |  225 ns |  225 ns |      ns |
# Beam gate porch  |  125 ns |  225 ns |  225 ns |  325 ns |  225 ns |      ns |
# Total gate delay | -350 ns | -450 ns | -450 ns | -550 ns | -450 ns |      ns |
# Spill width      | 1600 ns | 9500 ns | 1600 ns | 9500 ns | 1600 ns |      ns |
# Beam gate tail   |  350 ns |  250 ns |  375 ns | 1175 ns |  375 ns |      ns |
# Gate width       | 2100 ns |10200 ns | 2200 ns |11000 ns | 2200 ns |      ns |
# 
# These figures are arbitrarily rounded to match known values,
# since they are anyway uncertain because of their jitters.
# Run3 refers to the "stable" part from April on.
# 
# A model of how times go in triggering:
# 
# | cosmic ray crosses (just in time for being triggered, whatever that time is)
# |==1==| scintillation, photons arrive at PMT
#    :  |==2==| signal at digitizers
#    :     :  |==3==| LVDS signals at trigger logic (just in time for beam gate)
#  60 ns   :     :  |<-- "beam gate" opens (timestamp)
#        265 ns  :  |==5==| trigger logic evaluation, firing and timestamp
#              375 ns  :    <= "beam gate" opens (timestamp)
#                    225 ns
# (2) was measured with laser runs: average 265 ns
# (3+4+5) from waveforms of triggering light and trigger signal: 600 ns
# (4) from beam timestamp time to when trigger logic activates: assumed null
# (5) from earliest trigger minus beam gate timestamp: 225 ns
# (1) from CRT-PMT synchronization: 60 ns?
# 
# A number of (minor?) delays are neglected or implicitly included. For example:
#  * delay 4 may be one or two FPGA ticks (25 ns each)
# 
# When including neutrinos in simulation, the delay from simulation time start
# (when the first neutrino is generated 11 m upstream of the active volume) to
# the active volume needs to be added upfront (11 m / c = 35 ns).
# 
# Beam gate alignment can be extracted from data by matching emulation and
# actual trigger time from `raw::Trigger`:
#  * `TriggerTime()` for time alignment (trigger input + output delay)
#  * `TriggerTime() - BeamGateTime()` for the beam gate 
# 
# 
# The "trigger delay" turns into `TriggerInputDelay` of the simulation.
# The starting of the beam gate is contributed by:
#  1. the neutrino propagation delay (35 ns)
#  2. the PMT average cable delay (+265 ns)
#  3. the opposite of the beam gate porch (table above)
#  4. the opposite of the trigger delay (table above)
#  5. the opposite of the trigger timestamping delay (-125 ns)
# The first two delays point to the signal generated at t=0 at PMT digitization.
# The third one allows triggering on signal earlier than the spill.
# The fourth says how earlier we need to open the gate to catch that signal.
#
# This was for simulation. For data (emulation on actual PMT signal), we already
# have the beam gate that was used to get the trigger distributions we observe;
# But the simulation 
#
icarus_triggertiming_Run2: {
  BNB:  { Start:  { SetTo: "-0.050 us" } Width:  { SetTo:  "2.1 us" } }
  NuMI: { Start:  { SetTo: "-0.150 us" } Width:  { SetTo: "10.2 us" } }
  
  TriggerInputDelay:  "0 ns"
  TriggerOutputDelay: "0 ns"
  TriggerLVDSdelay:   "0 ns"
  
} # icarus_triggertiming_Run2

icarus_triggertiming_Run3: {
  BNB:  { Start:  { SetTo: "-0.150 us" } Width:  { SetTo:  "2.1 us" } }
  NuMI: { Start:  { SetTo: "-0.250 us" } Width:  { SetTo: "10.2 us" } }
  
  TriggerInputDelay:  "0 ns"
  TriggerOutputDelay: "0 ns"
  TriggerLVDSdelay:   "0 ns"
  
} # icarus_triggertiming_Run3

icarus_triggertiming_Run4: {
  # tuning on 20260617 by petrillo@slac.stanford.edu based on run 14292 (end of Run5)
  BNB:  { Start:  { SetTo: "-0.150 us" } Width:  { SetTo:  "2.1 us" } }
  NuMI: { Start:  { SetTo: "-0.250 us" } Width:  { SetTo: "10.2 us" } }
  
  TriggerInputDelay:  " 90 ns" # start of hardware trigger - beam gate profile
  TriggerOutputDelay: "225 ns" # +/- 12 ns: emulated trigger time minus hardware trigger time
  TriggerLVDSdelay:     "0 ns"
  
} # icarus_triggertiming_Run4

icarus_triggersimgates_Run2: {
  module_type: FixBeamGateInfo
  BeamGateTag: beamgate
  Changes: [
    { Select: { Types: [ "BNB"  ] } @table::icarus_triggertiming_Run2.BNB  },
    { Select: { Types: [ "NuMI" ] } @table::icarus_triggertiming_Run2.NuMI }
    ]
} # icarus_triggersimgates_Run2

icarus_triggersimgates_Run3: {
  @table::icarus_triggersimgates_Run2
  Changes: [
    { Select: { Types: [ "BNB"  ] } Start:  { SetTo: "-0.150 us" } Width:  { SetTo:  "2.2 us" } },
    { Select: { Types: [ "NuMI" ] } Start:  { SetTo: "-0.250 us" } Width:  { SetTo: "11.0 us" } }
    ]
} # icarus_triggersimgates_Run3

icarus_triggersimgates_Run4: {
  @table::icarus_triggersimgates_Run2
  Changes: [
    { Select: { Types: [ "BNB"  ] } Start:  { SetTo: "-0.150 us" } Width:  { SetTo:  "2.2 us" } }
    ]
} # icarus_triggersimgates_Run4

icarus_triggersimgates_Run5: {  # provisional
  @table::icarus_triggersimgates_Run4
} # icarus_triggersimgates_Run5

icarus_triggersimgates_Run1: @local::icarus_triggersimgates_Run2

icarus_triggertiming: @local::icarus_triggertiming_Run4
icarus_triggersimgates: @local::icarus_triggersimgates_Run4


###
### enable gate for the trigger primitives
###

#
# this gate is read from the simulation settings
#
icarus_enablegate_sim: {

  module_type: WriteBeamGateInfo
  
  BeamGates: [
    {
      Duration: @local::icarus_pmtsimulationalg_standard_run2.ReadoutEnablePeriod  # from pmtsimulation_icarus.fcl
      Start:    @local::icarus_pmtsimulationalg_standard_run2.TriggerOffsetPMT  # from pmtsimulation_icarus.fcl
    }
  ]
  
} # icarus_enablegate_sim


icarus_enablegate: @local::icarus_enablegate_sim


